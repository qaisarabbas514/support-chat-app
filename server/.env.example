# ---------- Server ----------
NODE_ENV=development
PORT=5000

# ---------- Database (MongoDB Atlas free tier M0) ----------
# Atlas > Connect > Drivers > copy the URI, put your DB user/password and DB name
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/support-chat?retryWrites=true&w=majority

# ---------- CORS / Socket.io ----------
# Comma-separated list of allowed frontend origins (no trailing slash).
# Local: http://localhost:5173   Production: add your Vercel URL
CLIENT_URL=http://localhost:5173

# ---------- Auth (Phase 2) ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ---------- Seed: first Manager account ----------
SEED_MANAGER_NAME=Admin Manager
SEED_MANAGER_EMAIL=manager@example.com
SEED_MANAGER_PASSWORD=ChangeMe123!

# ---------- Email (Nodemailer + Mailtrap in development) ----------
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_pass
EMAIL_FROM="Support Team <support@example.com>"

# ---------- Password reset ----------
# Frontend page that handles the reset link (token is appended)
RESET_PASSWORD_URL=http://localhost:5173/reset-password
RESET_TOKEN_EXPIRES_MINUTES=30
